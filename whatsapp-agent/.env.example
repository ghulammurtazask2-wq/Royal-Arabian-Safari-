# ── Anthropic (Claude) ──────────────────────────────────────────
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ── WhatsApp Business (Meta Cloud API) ─────────────────────────
# Get from: https://developers.facebook.com/apps → Your App → WhatsApp → API Setup

# The Phone Number ID (NOT the phone number itself)
# Found at: Meta Developer Console → WhatsApp → API Setup → "Phone number ID"
WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Permanent access token (create a System User in Business Manager for production)
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxx

# Any secret string you choose — entered in Meta webhook settings
WHATSAPP_VERIFY_TOKEN=royal_arabian_safari_secret_2024

# ── Owner Notification ──────────────────────────────────────────
# Your WhatsApp number (with country code, no spaces/dashes)
OWNER_WHATSAPP_NUMBER=+971582282683

# ── Server ─────────────────────────────────────────────────────
PORT=5000
FLASK_DEBUG=0
